import cv2
import os

output_folder = "/Users/byzeedmollah_/python projects/RealTimeImageManipulation/image_folder"
if not os.path.exists(output_folder):
    print("Folder does not exist!")

face_cascade = cv2.CascadeClassifier(
    cv2.data.haarcascades + 'haarcascade_frontalface_default.xml'
)

cap = cv2.VideoCapture(0)

if not cap.isOpened():
    print("Error: Could not access camera.")
    exit()

img_count = 0

def adjust_brightness(image, value=50):
    hsv = cv2.cvtColor(image, cv2.COLOR_BGR2HSV)
    h, s, v = cv2.split(hsv)

    v = cv2.add(v, value)
    v[v > 255] = 255

    final_hsv = cv2.merge((h, s, v))
    return cv2.cvtColor(final_hsv, cv2.COLOR_HSV2BGR)

while True:
    ret, frame = cap.read()
    if not ret:
        break

    gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)

    faces = face_cascade.detectMultiScale(
        gray, scaleFactor=1.3, minNeighbors=5
    )

    face_count = len(faces)

    for (x, y, w, h) in faces:
        cv2.rectangle(frame, (x, y), (x+w, y+h), (255, 0, 0), 2)

    cv2.putText(frame,
                f"Faces: {face_count}",
                (10, 30),
                cv2.FONT_HERSHEY_SIMPLEX,
                1,
                (0, 255, 0),
                2)
    
    cv2.imshow("Face Tracking, Count & Manipulation", frame)

    key = cv2.waitKey(1) & 0xFF

    if face_count > 0:
        x, y, w ,h = faces[0]
        face = frame[y:y+h, x:x+w]

        if key == ord('c'):
            path = f"{output_folder}/face_resized_{img_count}.jpg"
            cv2.imwrite(path, face)
            print(f"Cropped saved: {path}")
            img_count += 1

        elif key == ord('r'):
            resized = cv2.resize(face, (200, 200))
            path = f"{output_folder}/face_resized_{img_count}.jpg"
            cv2.imwrite(path, resized)
            print(f"Resized saved: {path}")
            img_count += 1
        
        elif key == ord('b'):
            bright = adjust_brightness(face, 60)
            path = f"{output_folder}/face_bright_{img_count}.jpg"
            cv2.imwrite(path, bright)
            print(f"Bright saved: {path}")
            img_count += 1

    if key == ord('q'):
        break

cap.release()
cv2.destroyAllWindows()